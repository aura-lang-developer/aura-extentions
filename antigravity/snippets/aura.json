{
  "Function Declaration": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}): ${3:Unit} => {",
      "\t$0",
      "}"
    ],
    "description": "Declare an Aura function"
  },
  "Main Entrypoint": {
    "prefix": "main",
    "body": [
      "export fn main(): Unit => {",
      "\tprintln(\"Hello, Aura!\");",
      "\t$0",
      "}"
    ],
    "description": "Main entrypoint for Aura executable"
  },
  "Let Binding": {
    "prefix": "let",
    "body": [
      "let ${1:name}: ${2:Type} = ${3:value};"
    ],
    "description": "Immutable let binding"
  },
  "Mutable Let Binding": {
    "prefix": "letmut",
    "body": [
      "let mut ${1:name}: ${2:Type} = ${3:value};"
    ],
    "description": "Mutable let binding"
  },
  "Algebraic Data Type (Enum/Sum Type)": {
    "prefix": "type-adt",
    "body": [
      "type ${1:Name} =",
      "\t| ${2:Variant1}",
      "\t| ${3:Variant2}(${4:Type});"
    ],
    "description": "Define a Sum Type / Algebraic Data Type"
  },
  "Record / Struct Type": {
    "prefix": "type-record",
    "body": [
      "type ${1:Name} = {",
      "\t${2:field}: ${3:Type},",
      "};"
    ],
    "description": "Define a record/struct type"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "\tfn ${2:method}(${3:param}: ${4:Type}): ${5:ReturnType};",
      "}"
    ],
    "description": "Define a Go-style structural interface"
  },
  "Pattern Match": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "\t${2:Pattern} => {",
      "\t\t$0",
      "\t},",
      "\t_ => {",
      "\t}",
      "}"
    ],
    "description": "Exhaustive pattern matching block"
  },
  "CSP Fiber Spawn": {
    "prefix": "spawn",
    "body": [
      "spawn {",
      "\t$0",
      "};"
    ],
    "description": "Spawn a lightweight concurrent fiber"
  },
  "Aura Routine": {
    "prefix": "routine",
    "body": [
      "routine {",
      "\t$0",
      "};"
    ],
    "description": "Launch an Aura Routine (lightweight concurrent task)"
  },
  "Goroutine": {
    "prefix": "go",
    "body": [
      "go {",
      "\t$0",
      "};"
    ],
    "description": "Launch a Go-style Goroutine (lightweight concurrent task)"
  },
  "Channel Creation": {
    "prefix": "channel",
    "body": [
      "let ${1:ch} = Channel<${2:Type}>::new(${3:10});"
    ],
    "description": "Create a typed buffered or unbuffered CSP Channel"
  },
  "Select Multiplexing": {
    "prefix": "select",
    "body": [
      "select {",
      "\tcase ${1:val} <- ${2:ch} => {",
      "\t\t$0",
      "\t},",
      "\tdefault => {",
      "\t}",
      "}"
    ],
    "description": "Multiplex channel operations with select"
  },
  "Defer Statement": {
    "prefix": "defer",
    "body": [
      "defer ${1:cleanup()};"
    ],
    "description": "Defer execution until enclosing function returns (LIFO)"
  },
  "HTTP Handler": {
    "prefix": "handler",
    "body": [
      "fn handle${1:Resource}(req: Request): Response => {",
      "\tResponse.json({ status: 200, message: \"$0\" })",
      "}"
    ],
    "description": "Create an HTTP request handler function"
  },
  "Unit Test": {
    "prefix": "test",
    "body": [
      "@test",
      "fn test_${1:feature}(): Unit => {",
      "\tlet result = ${2:call()};",
      "\tassert_eq(result, ${3:expected});",
      "}"
    ],
    "description": "Define an auratest unit test case"
  },
  "PostgreSQL Connection": {
    "prefix": "db-pg",
    "body": [
      "let client = pg::connect(\"${1:postgres://postgres:password@localhost:5432/db}\")?;"
    ],
    "description": "Connect to PostgreSQL database"
  },
  "Redis Client": {
    "prefix": "db-redis",
    "body": [
      "let client = redis::connect(\"${1:redis://127.0.0.1:6379}\")?;"
    ],
    "description": "Connect to Redis"
  },
  "HTTP Server": {
    "prefix": "http-server",
    "body": [
      "let server = http::Server::new();",
      "server.get(\"${1:/}\", fn(req, res) => {",
      "\tres.send(\"${2:Hello, Aura!}\");",
      "});",
      "server.listen(${3:8080});"
    ],
    "description": "Create and start native HTTP Server"
  }
}
