# Aura Snipmate / LuaSnip Snippets

snippet fn "Function Declaration"
	fn ${1:name}(${2:params}): ${3:Unit} => {
		${0}
	}

snippet export-fn "Exported Function Declaration"
	export fn ${1:Name}(${2:params}): ${3:Unit} => {
		${0}
	}

snippet fn-recv "Method Receiver (Value)"
	fn (${1:self}: ${2:ReceiverType}) ${3:MethodName}(${4:params}): ${5:ReturnType} => {
		${0}
	}

snippet fn-recv-ptr "Method Receiver (Pointer)"
	fn (${1:self}: *${2:ReceiverType}) ${3:MethodName}(${4:params}): ${5:ReturnType} => {
		${0}
	}

snippet main "Main Entrypoint"
	export fn main(): Unit => {
		println("Hello, Aura!");
		${0}
	}

snippet let "Let Binding"
	let ${1:name}: ${2:Type} = ${3:value};

snippet letmut "Mutable Let Binding"
	let mut ${1:name}: ${2:Type} = ${3:value};

snippet struct "Struct Declaration"
	struct ${1:Name} {
		${2:field}: ${3:Type}
	};

snippet export-struct "Exported Struct Declaration"
	export struct ${1:Name} {
		${2:field}: ${3:Type}
	};

snippet packed-struct "Packed Struct (Binary Alignment)"
	export packed struct ${1:Name} {
		${2:field}: ${3:Type}
	};

snippet interface "Structural Interface"
	export interface ${1:Name} {
		${2:MethodName}(${3:param}: ${4:Type}): ${5:ReturnType};
	}

snippet match "Pattern Match"
	match ${1:expr} {
		${2:Pattern} => {
			${0}
		},
		_ => {
		}
	}

snippet for "For in Loop"
	for ${1:item} in ${2:iterable} {
		${0}
	}

snippet for-idx "For in Loop with Index"
	for ${1:index}, ${2:item} in ${3:iterable} {
		${0}
	}

snippet while "While Loop"
	while ${1:condition} {
		${0}
	}

snippet defer "Defer Statement"
	defer ${1:resource.close()};

snippet errdefer "Errdefer Statement"
	errdefer ${1:cleanupOnFailure()};

snippet spawn "CSP Fiber Spawn"
	spawn {
		${0}
	};

snippet channel "Channel Creation"
	let ${1:ch} = Channel.new(${2:10});

snippet select "Select Multiplexing"
	select {
		case ${1:msg} <- ${2:channel} => {
			${0}
		},
		default => {
		}
	}

snippet embed "Embed Static Text"
	let ${1:asset} = embed("${2:path/to/asset.txt}");

snippet embedBytes "Embed Static Binary"
	let ${1:bytes} = embedBytes("${2:path/to/binary.bin}");

snippet build-tag "Build Tag Directive"
	//aura:build ${1:darwin || linux}

snippet http-server "HTTP Server with ServeMux"
	let mux = http.newServeMux();

	mux.get("/api/health", fn(req: Any, res: Any) => {
		http.json(res, http.StatusOK, { status: "ok", timestamp: time.now() });
	});

	let port = os.env("PORT") != "" ? os.env("PORT") : "8080";
	println(\`🚀 Server listening on :\${port}\`);
	// mux.listenAndServe(\`:\${port}\`);

snippet sync-mutex "Sync Mutex"
	let ${1:mu} = Mutex.new();
	${1:mu}.lock();
	defer ${1:mu}.unlock();
	${0}

snippet test "Unit Test Case"
	@test
	fn test_${1:feature}(): Unit => {
		let result = ${2:call()};
		assert_eq(result, ${3:expected});
	}

snippet bench "Benchmark Test"
	@bench
	fn bench_${1:operation}(): Unit => {
		${0}
	}

snippet test-go "Go-Style Test Function"
	fn Test${1:Feature}(t: *testing.T) => {
		t.Helper();
		let got = ${2:call()};
		let want = ${3:expected};
		if (got != want) {
			t.Errorf("${1:Feature}() = %v, want %v", got, want);
		}
	}

snippet test-table "Go-Style Table Driven Test"
	fn Test${1:Feature}TableDriven(t: *testing.T) => {
		let tests = [
			{ name: "${2:case1}", input: ${3:value}, want: ${4:expected} },
		];

		for tc in tests {
			t.Run(tc.name, fn(t: *testing.T) => {
				t.Parallel();
				let got = ${5:call(tc.input)};
				if (got != tc.want) {
					t.Fatalf("got %v, want %v", got, tc.want);
				}
			});
		}
	}

snippet bench-go "Go-Style Benchmark"
	fn Benchmark${1:Operation}(b: *testing.B) => {
		b.ReportAllocs();
		b.ResetTimer();
		for (let mut i = 0; i < b.N; i = i + 1) {
			${2:Operation()};
		}
	}

snippet example "Go-Style Example Function"
	fn Example${1:Feature}() => {
		println(${2:call()});
		// Output:
		// ${3:expected_output}
	}

snippet db-pg "PostgreSQL Database Connection"
	import { connect } from "pg";

	let db = pg.connect("postgres://${1:user}:${2:password}@${3:localhost}:5432/${4:mydb}?sslmode=disable")?;
	defer db.close();

	let rows = db.query("SELECT id, name FROM users WHERE active = $1", [true])?;
	defer rows.close();

	for row in rows {
		println(\`User: \${row.id} - \${row.name}\`);
	}

snippet db-mysql "MySQL Database Connection"
	import { connect } from "mysql";

	let db = mysql.connect("${1:user}:${2:password}@tcp(${3:localhost}:3306)/${4:mydb}")?;
	defer db.close();

	let rows = db.query("SELECT id, title FROM items")?;
	defer rows.close();

snippet redis-client "Redis Cache Client"
	import { connect } from "redis";

	let rdb = redis.connect("redis://${1:localhost}:6379")?;
	defer rdb.close();

	rdb.set("${2:key}", "${3:value}", 3600);
	let val = rdb.get("${2:key}");
	println(\`Redis val: \${val}\`);

snippet mongo-client "MongoDB Client"
	import { connect } from "mongo";

	let client = mongo.connect("mongodb://${1:localhost}:27017")?;
	defer client.close();

	let col = client.database("${2:mydb}").collection("${3:users}");
	col.insertOne({ name: "${4:Alice}", role: "admin" });

snippet csp-worker-pool "CSP Worker Pool"
	import { WaitGroup } from "sync";

	let jobs = Channel.new<Int>(100);
	let results = Channel.new<Int>(100);
	let wg = WaitGroup.new();

	for w in 1..=${1:4} {
		wg.add(1);
		spawn {
			defer wg.done();
			for j in jobs {
				results <- (j * 2);
			}
		};
	}

	spawn {
		for j in 1..=${2:10} {
			jobs <- j;
		}
		jobs.close();
		wg.wait();
		results.close();
	};
