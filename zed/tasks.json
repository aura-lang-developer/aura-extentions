[
  {
    "label": "Aura: Run Active File",
    "command": "aurac run \"$ZED_FILE\"",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Aura: Interactive Step Debugger (CLI)",
    "command": "aurac step \"$ZED_FILE\"",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Aura: Type Check Active File",
    "command": "aurac check \"$ZED_FILE\"",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Aura: Build Standalone Native Binary (Cranelift)",
