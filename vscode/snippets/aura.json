  },
  "Labeled Loop": {
    "prefix": "loop-label",
    "body": [
      "'${1:outer}: for ${2:item} in ${3:iterable} {",
      "\tif (${4:condition}) {",
      "\t\tbreak '${1:outer};",
      "\t}",
      "\t$0",
      "}"
    ],
    "description": "Loop with label for target break/continue"
  },
  "Defer Statement": {
    "prefix": "defer",
    "body": [
