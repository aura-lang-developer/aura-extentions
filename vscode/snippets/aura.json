{
  "Function Declaration": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}): ${3:Unit} => {",
      "\t$0",
      "}"
    ],
    "description": "Declare an Aura function"
  },
  "Exported Function Declaration": {
    "prefix": "export-fn",
    "body": [
      "export fn ${1:Name}(${2:params}): ${3:Unit} => {",
      "\t$0",
      "}"
    ],
    "description": "Declare an exported public Aura function"
  },
  "Method Receiver (Value Receiver)": {
    "prefix": "fn-recv",
    "body": [
      "fn (${1:self}: ${2:ReceiverType}) ${3:MethodName}(${4:params}): ${5:ReturnType} => {",
      "\t$0",
      "}"
    ],
    "description": "Declare a struct method with value receiver"
  },
  "Method Receiver (Pointer Receiver)": {
    "prefix": "fn-recv-ptr",
    "body": [
      "fn (${1:self}: *${2:ReceiverType}) ${3:MethodName}(${4:params}): ${5:ReturnType} => {",
      "\t$0",
      "}"
    ],
    "description": "Declare a struct method with mutable pointer receiver"
  },
  "Main Entrypoint": {
    "prefix": "main",
    "body": [
      "export fn main(): Unit => {",
      "\tprintln(\"Hello, Aura!\");",
      "\t$0",
      "}"
    ],
    "description": "Main entrypoint for Aura standalone executable"
  },
  "Let Binding": {
    "prefix": "let",
    "body": [
      "let ${1:name}: ${2:Type} = ${3:value};"
    ],
    "description": "Immutable let binding"
  },
  "Mutable Let Binding": {
    "prefix": "letmut",
    "body": [
      "let mut ${1:name}: ${2:Type} = ${3:value};"
    ],
    "description": "Mutable let binding"
  },
  "Struct Declaration": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:Type}",
      "};"
    ],
    "description": "Declare a domain struct"
  },
  "Exported Struct Declaration": {
    "prefix": "export-struct",
    "body": [
      "export struct ${1:Name} {",
      "\t${2:field}: ${3:Type}",
      "};"
    ],
    "description": "Declare an exported public struct"
  },
  "Packed Struct (Binary Alignment)": {
    "prefix": "packed-struct",
    "body": [
      "export packed struct ${1:Name} {",
      "\t${2:field}: ${3:Type}",
      "};"
    ],
    "description": "Declare a packed struct with zero-padding binary layout"
  },
  "Algebraic Data Type (Sum Type)": {
    "prefix": "type-adt",
    "body": [
      "type ${1:Name} =",
      "\t| ${2:Variant1}",
      "\t| ${3:Variant2}(${4:Type});"
    ],
    "description": "Define a Sum Type / Tagged Union"
  },
  "Record Type Alias": {
    "prefix": "type-record",
    "body": [
      "type ${1:Name} = {",
      "\t${2:field}: ${3:Type},",
      "};"
    ],
    "description": "Define a record type alias"
  },
  "Structural Interface": {
    "prefix": "interface",
    "body": [
      "export interface ${1:Name} {",
      "\t${2:MethodName}(${3:param}: ${4:Type}): ${5:ReturnType};",
      "}"
    ],
    "description": "Define a Go-style structural interface (Duck Typing)"
  },
  "Trait Definition": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\tfn ${2:method}(${3:param}: ${4:Type}): ${5:ReturnType};",
      "}"
    ],
    "description": "Define a trait contract"
  },
  "Trait Implementation": {
    "prefix": "impl-trait",
    "body": [
      "impl ${1:Trait} for ${2:Type} {",
      "\tfn ${3:method}(${4:param}: ${5:ParamType}): ${6:ReturnType} => {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Implement a trait for a specific type"
  },
  "Pattern Match": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "\t${2:Pattern} => {",
      "\t\t$0",
      "\t},",
      "\t_ => {",
      "\t}",
      "}"
    ],
    "description": "Exhaustive pattern matching block"
  },
  "For In Loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:iterable} {",
      "\t$0",
      "}"
    ],
    "description": "Iterate over collection or channel"
  },
  "For In Loop with Index": {
    "prefix": "for-idx",
    "body": [
      "for ${1:index}, ${2:item} in ${3:iterable} {",
      "\t$0",
      "}"
    ],
    "description": "Iterate with zero-based counter and element"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "While continuation loop"
  },
  "Labeled Loop": {
    "prefix": "loop-label",
    "body": [
      "'${1:outer}: for ${2:item} in ${3:iterable} {",
      "\tif (${4:condition}) {",
      "\t\tbreak '${1:outer};",
      "\t}",
      "\t$0",
      "}"
    ],
    "description": "Loop with label for target break/continue"
  },
  "Defer Statement": {
    "prefix": "defer",
    "body": [
      "defer ${1:resource.close()};"
    ],
    "description": "Defer cleanup expression on scope exit (LIFO)"
  },
  "ErrDefer Statement": {
    "prefix": "errdefer",
    "body": [
      "errdefer ${1:cleanupOnFailure()};"
    ],
    "description": "Execute cleanup only if panic or error occurs (Zig model)"
  },
  "CSP Fiber Spawn": {
    "prefix": "spawn",
    "body": [
      "spawn {",
      "\t$0",
      "};"
    ],
    "description": "Spawn a lightweight concurrent fiber"
  },
  "Aura Routine": {
    "prefix": "routine",
    "body": [
      "routine {",
      "\t$0",
      "};"
    ],
    "description": "Launch an Aura Routine"
  },
  "Goroutine": {
    "prefix": "go",
    "body": [
      "go {",
      "\t$0",
      "};"
    ],
    "description": "Launch a Go-style Goroutine"
  },
  "Channel Creation": {
    "prefix": "channel",
    "body": [
      "let ${1:ch} = Channel.new(${2:10});"
    ],
    "description": "Create a typed CSP Channel"
  },
  "Select Multiplexing": {
    "prefix": "select",
    "body": [
      "select {",
      "\tcase ${1:msg} <- ${2:channel} => {",
      "\t\t$0",
      "\t},",
      "\tdefault => {",
      "\t}",
      "}"
    ],
    "description": "Multiplex channel operations with select"
  },
  "Embed Static Asset": {
    "prefix": "embed",
    "body": [
      "let ${1:asset} = embed(\"${2:path/to/asset.txt}\");"
    ],
    "description": "Compile-time embedded text asset"
  },
  "Embed Binary Asset": {
    "prefix": "embedBytes",
    "body": [
      "let ${1:bytes} = embedBytes(\"${2:path/to/binary.bin}\");"
    ],
    "description": "Compile-time embedded binary bytes"
  },
  "Build Tag Directive (Aura)": {
    "prefix": "build-tag",
    "body": [
      "//aura:build ${1:darwin || linux}"
    ],
    "description": "Conditional build tag directive"
  },
  "HTTP Server with ServeMux": {
    "prefix": "http-server",
    "body": [
      "let mux = http.newServeMux();",
      "",
      "mux.get(\"/api/health\", fn(req: Any, res: Any) => {",
      "\thttp.json(res, http.StatusOK, { status: \"ok\", timestamp: time.now() });",
      "});",
      "",
      "let port = os.env(\"PORT\") != \"\" ? os.env(\"PORT\") : \"8080\";",
      "println(`🚀 Server listening on :${port}`);",
      "// mux.listenAndServe(`:${port}`);"
    ],
    "description": "Create a Golang net/http style backend HTTP server"
  },
  "Sync Mutex": {
    "prefix": "sync-mutex",
    "body": [
      "let ${1:mu} = Mutex.new();",
      "${1:mu}.lock();",
      "defer ${1:mu}.unlock();",
      "$0"
    ],
    "description": "Thread-safe mutex synchronization with defer unlock"
  },
  "Map Literal": {
    "prefix": "map",
    "body": [
      "#{ \"${1:key}\" => ${2:value} }"
    ],
    "description": "Associative key-value map literal"
  },
  "Set Literal": {
    "prefix": "set",
    "body": [
      "#[ ${1:item1}, ${2:item2} ]"
    ],
    "description": "Unique set literal"
  },
  "Unit Test Case": {
    "prefix": "test",
    "body": [
      "@test",
      "fn test_${1:feature}(): Unit => {",
      "\tlet result = ${2:call()};",
      "\tassert_eq(result, ${3:expected});",
      "}"
    ],
    "description": "Define an auratest unit test case"
  },
  "Benchmark Test": {
    "prefix": "bench",
    "body": [
      "@bench",
      "fn bench_${1:operation}(): Unit => {",
      "\t$0",
      "}"
    ],
    "description": "Define an auratest benchmark performance test"
  }
}
