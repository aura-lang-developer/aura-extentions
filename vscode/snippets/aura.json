  "MongoDB Client": {
    "prefix": "mongo-client",
    "body": [
      "import { connect } from \"mongo\";",
      "",
      "let client = mongo.connect(\"mongodb://${1:localhost}:27017\")?;",
      "defer client.close();",
      "",
      "let col = client.database(\"${2:mydb}\").collection(\"${3:users}\");",
      "col.insertOne({ name: \"${4:Alice}\", role: \"admin\" });"
    ],
    "description": "Native MongoDB client with collection operations"
  },
  "CSP Worker Pool": {
    "prefix": "csp-worker-pool",
    "body": [
      "import { WaitGroup } from \"sync\";",
      "",
      "let jobs = Channel.new<Int>(100);",
      "let results = Channel.new<Int>(100);",
      "let wg = WaitGroup.new();",
      "",
      "// Spawn worker fibers",
      "for w in 1..=${1:4} {",
      "\twg.add(1);",
      "\tspawn {",
      "\t\tdefer wg.done();",
      "\t\tfor j in jobs {",
      "\t\t\tresults <- (j * 2);",
      "\t\t}",
      "\t};",
      "}",
      "",
      "// Send jobs and close channel",
      "spawn {",
      "\tfor j in 1..=${2:10} {",
      "\t\tjobs <- j;",
      "\t}",
      "\tjobs.close();",
      "\twg.wait();",
      "\tresults.close();",
      "};"
    ],
    "description": "High-throughput CSP worker pool with M:N fibers and WaitGroup"
  }
}
