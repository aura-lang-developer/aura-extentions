    ],
    "description": "Declare an exported public struct"
  },
  "Packed Struct (Binary Alignment)": {
    "prefix": "packed-struct",
    "body": [
      "export packed struct ${1:Name} {",
      "\t${2:field}: ${3:Type}",
      "};"
    ],
    "description": "Declare a packed struct with zero-padding binary layout"
  },
  "Algebraic Data Type (Sum Type)": {
    "prefix": "type-adt",
    "body": [
      "type ${1:Name} =",
      "\t| ${2:Variant1}",
      "\t| ${3:Variant2}(${4:Type});"
    ],
    "description": "Define a Sum Type / Tagged Union"
  },
  "Record Type Alias": {
    "prefix": "type-record",
    "body": [
      "type ${1:Name} = {",
      "\t${2:field}: ${3:Type},",
